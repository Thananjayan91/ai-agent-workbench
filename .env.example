OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini

# Free tier at https://tavily.com — used by the web_search tool. Leave blank and
# web_search will fail gracefully (retries, then reports the error to the model).
TAVILY_API_KEY=tvly-...

# Local dev: SQLite, no server needed. For production, point at a real Postgres instance:
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_workbench
DATABASE_URL=sqlite:///./data/agent.db

# Comma-separated allowlist for the http_get tool. Empty = allow any public domain (private/loopback/link-local IPs are always blocked).
HTTP_TOOL_ALLOWED_DOMAINS=

MAX_AGENT_ITERATIONS=15
TOOL_MAX_RETRIES=2
